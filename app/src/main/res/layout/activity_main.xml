<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="19dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="سلام، خوش آمدی 👋"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مدیریت مالی شخصی شما"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="5dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="49dp"
                android:gravity="center"
                android:text="HESABAK"
                android:textSize="17sp"
                android:paddingHorizontal="10dp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/dashboard_card_bg"/>
        </LinearLayout>

        <!-- BALANCE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="25dp"
            android:background="@drawable/balance_card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="موجودی کل حساب‌ها"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:alpha="0.85"/>

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 افغانی"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="12dp"
                android:singleLine="true"
                android:ellipsize="end"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="موجودی فعلی شما"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:alpha="0.75"/>
        </LinearLayout>

        <!-- MONTHLY SUMMARY -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="خلاصه وضعیت ماه جاری"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- INCOME -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="113dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/dashboard_card_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="↑ درآمد این ماه"
                    android:textSize="12sp"
                    android:textColor="@color/income"/>

                <TextView
                    android:id="@+id/tvIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 افغانی"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="end"
                    android:layout_marginTop="18dp"
                    android:singleLine="true"
                    android:ellipsize="end"/>
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <!-- EXPENSE -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="113dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:background="@drawable/dashboard_card_bg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="↓ مصرف این ماه"
                    android:textSize="12sp"
                    android:textColor="@color/expense"/>

                <TextView
                    android:id="@+id/tvExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 افغانی"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="end"
                    android:layout_marginTop="18dp"
                    android:singleLine="true"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- MONTHLY REMAINING -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:padding="16dp"
            android:background="@drawable/dashboard_card_bg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="باقی‌مانده این ماه"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"/>

            <TextView
                android:id="@+id/tvRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 افغانی"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary"/>
        </LinearLayout>

        <!-- QUICK ACTIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="عملیات سریع"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddTransaction"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="+ ثبت تراکنش"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/income"
                android:textAllCaps="false"
                android:background="@drawable/dashboard_button_bg"
                android:backgroundTint="@null"/>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnViewTransactions"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="تمام تراکنش‌ها"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:textAllCaps="false"
                android:background="@drawable/dashboard_button_bg"
                android:backgroundTint="@null"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnReports"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="گزارش‌ها و تحلیل مالی"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:background="@drawable/dashboard_button_bg"
            android:backgroundTint="@null"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="12dp"/>

        <!-- RECENT TRANSACTIONS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="آخرین تراکنش‌ها"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:id="@+id/recentTransactionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <Button
            android:id="@+id/btnAboutDeveloper"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:text="درباره سازنده"
            android:textSize="15sp"
            android:textColor="@color/primary"
            android:backgroundTint="@color/surface_alt"/>


    </LinearLayout>

</ScrollView>
